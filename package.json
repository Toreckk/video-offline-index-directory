{
  "name": "void-workspace",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "vite",
    "dev:desktop": "pnpm --filter @void/desktop tauri dev",
    "dev:desktop-ui": "pnpm --filter @void/desktop dev",
    "build": "pnpm build:web",
    "build:web": "tsc -b && vite build",
    "build:desktop-ui": "pnpm --filter @void/desktop build",
    "build:desktop": "pnpm --filter @void/desktop tauri build",
    "verify:version": "node scripts/verify-version.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "inventory:dependencies": "node scripts/dependency-inventory.mjs",
    "test:release": "node --test scripts/*.test.mjs",
    "check": "pnpm verify:version && pnpm verify:docs && pnpm test:release && pnpm test && pnpm lint && pnpm build:web && pnpm build:desktop-ui",
    "test:release:native": "pwsh -NoProfile -File scripts/publish-release.test.ps1",
    "check:native": "pnpm test:release:native && cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all -- --check && cargo clippy --locked --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --locked --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "bench:v0.2": "vitest bench benchmarks/v0.2.bench.ts benchmarks/v0.2-render.bench.tsx --run --no-file-parallelism",
    "bench:v0.3.2": "vitest bench benchmarks/v0.3.2-thumbnail-navigation.bench.tsx --run --no-file-parallelism",
    "preview": "vite preview"
  },
  "dependencies": {
    "@void/app": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "25.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
