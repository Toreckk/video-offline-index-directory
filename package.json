{
  "name": "void-workspace",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "vite",
    "dev:desktop": "pnpm --filter @void/desktop tauri dev",
    "dev:desktop-ui": "pnpm --filter @void/desktop dev",
    "build": "pnpm build:web",
    "build:web": "tsc -b && vite build",
    "build:desktop-ui": "pnpm --filter @void/desktop build",
    "build:desktop": "pnpm --filter @void/desktop tauri build",
    "verify:version": "node scripts/verify-version.mjs",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "bench:v0.2": "vitest bench benchmarks/v0.2.bench.ts benchmarks/v0.2-render.bench.tsx --run --no-file-parallelism",
    "preview": "vite preview"
  },
  "dependencies": {
    "@void/app": "workspace:*",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.6"
  }
}
